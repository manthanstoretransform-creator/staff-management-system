# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# ─── Virtual Environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env

# ─── Distribution / Build ─────────────────────────────────────────────────────
build/
dist/
*.egg-info/
*.egg
.eggs/

# ─── Testing ──────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
*.xml

# ─── IDE / Editor ─────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── App Runtime / Temp ───────────────────────────────────────────────────────
# Screenshots captured at runtime (keep folder via .gitkeep)
screenshot/*.png
screenshot/*.jpg
screenshot/*.jpeg
screenshot/*.webp

# Local SQLite cache / offline data
*.db
*.sqlite
*.sqlite3

# Logs
*.log
logs/

# ─── Secrets (never commit) ───────────────────────────────────────────────────
.env
# .env.example is intentionally NOT ignored - it's a safe template
